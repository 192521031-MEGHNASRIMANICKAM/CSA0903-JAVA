class ParkingTicket {
    private final int ticketNumber;
    private final String vehicleNumber;
    private final String entryTime;
 
    ParkingTicket() {
        this(0, "UNKNOWN", "NOT RECORDED");
    }
 
    ParkingTicket(int ticketNumber, String vehicleNumber) {
        this(ticketNumber, vehicleNumber, "NOT RECORDED");
    }
 
    ParkingTicket(int ticketNumber, String vehicleNumber, String entryTime) {
        this.ticketNumber = ticketNumber;
        this.vehicleNumber = vehicleNumber;
        this.entryTime = entryTime;
    }
 
    ParkingTicket(ParkingTicket other) {
        this(other.ticketNumber, other.vehicleNumber, other.entryTime);
    }
 
    void display() {
        System.out.println(ticketNumber + " " + vehicleNumber + " " + entryTime);
    }
}
 
public class Task04 {
    public static void main(String[] args) {
        ParkingTicket t1 = new ParkingTicket();
        ParkingTicket t2 = new ParkingTicket(1001, "TN01AB1234", "09:30");
        ParkingTicket t3 = new ParkingTicket(t2);
        t1.display();
        t2.display();
        t3.display();
    }
}
