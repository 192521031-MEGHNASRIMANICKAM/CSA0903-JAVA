interface Chargeable {
    double chargingFee(int units);
 
    default void showChargingStatus() {
        System.out.println("Charging facility available");
    }
}
 
abstract class Vehicle {
    protected final String regNo;
 
    Vehicle(String regNo) {
        this.regNo = regNo;
    }
 
    abstract double calculateParkingFee(int hours);
}
 
class ElectricCar extends Vehicle implements Chargeable {
    ElectricCar(String regNo) {
        super(regNo);
    }
 
    @Override
    double calculateParkingFee(int hours) {
        return hours * 30.0;
    }
 
    @Override
    public double chargingFee(int units) {
        return units * 12.0;
    }
}
 
public class Task09 {
    public static void main(String[] args) {
        ElectricCar car = new ElectricCar("TN01EV1234");
        car.showChargingStatus();
        System.out.println("Parking fee: Rs " +
                car.calculateParkingFee(2));
        System.out.println("Charging fee: Rs " +
                car.chargingFee(5));
    }
}
