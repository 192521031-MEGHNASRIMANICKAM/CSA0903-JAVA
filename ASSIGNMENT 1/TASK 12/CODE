import java.time.LocalTime;
import java.util.Arrays;
 
public class Task12 {
    interface ParkingPass {
        boolean isValid();
    }
 
    static class OneDayPass implements ParkingPass {
        private final java.time.LocalDate validDate;
 
        OneDayPass(java.time.LocalDate validDate) {
            this.validDate = validDate;
        }
 
        public boolean isValid() {
            return validDate.equals(java.time.LocalDate.now());
        }
    }
 
    static class Vehicle {
        final String regNo;
 
        Vehicle(String regNo) {
            this.regNo = regNo;
        }
    }
 
    static class Car extends Vehicle {
        Car(String regNo) {
            super(regNo);
        }
    }
 
    static class EBike extends Vehicle {
        EBike(String regNo) {
            super(regNo);
        }
    }
 
    static class DeliveryVan extends Vehicle {
        DeliveryVan(String regNo) {
            super(regNo);
        }
    }
 
    static class ParkingFacility {
        private final String[][] slots;
 
        ParkingFacility(int[] slotsPerFloor) {
            slots = new String[slotsPerFloor.length][];
            for (int i = 0; i < slotsPerFloor.length; i++) {
                slots[i] = new String[slotsPerFloor[i]];
            }
        }
 
        int[] allocate(String regNo) {
            for (int f = 0; f < slots.length; f++) {
                for (int s = 0; s < slots[f].length; s++) {
                    if (slots[f][s] == null) {
                        slots[f][s] = regNo;
                        return new int[]{f, s};
                    }
                }
            }
            return null;
        }
    }
 
    static double calculateFee(Vehicle vehicle, int hours,
                               LocalTime entryTime, ParkingPass pass) {
        if (pass != null && pass.isValid()) return 0.0;
 
        if (vehicle instanceof EBike) {
            return 20.0;
        }
 
        if (vehicle instanceof DeliveryVan) {
            boolean daytime = !entryTime.isBefore(LocalTime.of(9, 0)) &&
                    entryTime.isBefore(LocalTime.of(17, 0));
            double carRate = 30.0;
            return hours * (daytime ? 2 * carRate : carRate);
        }
 
        return hours * 30.0;
    }
 
    public static void main(String[] args) {
        ParkingFacility facility =
                new ParkingFacility(new int[]{20, 25, 30, 35, 40});
 
        Vehicle ebike = new EBike("TN10EB1001");
        Vehicle van = new DeliveryVan("TN10DV1002");
        Vehicle visitorCar = new Car("TN10VC1003");
 
        System.out.println("E-bike slot: " +
                Arrays.toString(facility.allocate(ebike.regNo)));
        System.out.println("Van slot: " +
                Arrays.toString(facility.allocate(van.regNo)));
        System.out.println("Visitor car slot: " +
                Arrays.toString(facility.allocate(visitorCar.regNo)));
 
        System.out.println("E-bike fee: Rs " +
                calculateFee(ebike, 2, LocalTime.of(10, 0), null));
        System.out.println("Van fee: Rs " +
                calculateFee(van, 2, LocalTime.of(10, 0), null));
 
        OneDayPass pass = new OneDayPass(java.time.LocalDate.now());
        System.out.println("Visitor pass fee: Rs " +
                calculateFee(visitorCar, 2, LocalTime.of(11, 0), pass));
    }
}
