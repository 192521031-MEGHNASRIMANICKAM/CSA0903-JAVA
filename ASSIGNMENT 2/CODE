    static Vehicle createVehicle(String type, String regNo) {
        return switch (type.toLowerCase()) {
            case "two-wheeler" -> new TwoWheeler(regNo);
            case "car" -> new Car(regNo);
            case "electric-car" -> new ElectricCar(regNo);
            case "e-bike" -> new EBike(regNo);
            case "delivery-van" -> new DeliveryVan(regNo);
            default -> throw new IllegalArgumentException("Unknown vehicle type: " + type);
        };
    }

