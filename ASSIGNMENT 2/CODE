
        public boolean releaseSlot(int floor, int slot) {
            if (floor < 0 || floor >= slots.length || slot < 0 || slot >= slots[floor].length || slots[floor][slot] == null)
                return false;
            Vehicle vehicle = slots[floor][slot];
            ParkingTicket ticket = ticketIndex.remove(vehicle.getRegNo());
            slots[floor][slot] = null;
            if (ticket != null) {
                for (int i = 0; i < activeTickets.length; i++)
                    if (activeTickets[i] == ticket) { activeTickets[i] = null; break; }
            }
            occupied--;
            return true;
        }

        public int getOccupied() { return occupied; }
        public int getCapacity() { return activeTickets.length; }
        public ParkingTicket findTicket(String regNo) { return ticketIndex.get(regNo.toUpperCase()); }
    }

